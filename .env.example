# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit file .env.
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/xenchat

# Wajib diisi, minimal 32 karakter. Buat dengan:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Opsional: daftar origin yang diizinkan (pisahkan dengan koma) jika frontend dihosting terpisah.
# Kosongkan jika frontend dilayani oleh server ini (same-origin).
CORS_ORIGINS=

# Set 1 jika berjalan di belakang reverse proxy (Nginx, Render, Railway, dll.)
TRUST_PROXY=0

# Lokasi penyimpanan file media (story, foto grup/saluran). Default: ./uploads
# Pastikan folder ini TIDAK dilayani sebagai static dan dicadangkan.
UPLOAD_DIR=

# --- Owner platform (dibuat otomatis jika belum ada; JANGAN commit nilai asli) ---
OWNER_NAME=XenChat Owner
OWNER_USERNAME=
OWNER_EMAIL=
OWNER_PASSWORD=

# --- WebRTC (panggilan) ---
# STUN publik default cukup untuk jaringan sederhana. Untuk NAT ketat / seluler, sediakan server TURN.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_PASSWORD=
